+package com.android.systemui.haptics
+
+import android.os.VibrationEffect
+
+/** Short continuous pulse (~42 ms), medium strength — no chained primitives. */
+object FuxiHapticEffects {
+
+    private const val PULSE_MS = 42L
+    private const val PULSE_AMPLITUDE = 168
+
+    private val shortPulse: VibrationEffect =
+        VibrationEffect.createOneShot(PULSE_MS, PULSE_AMPLITUDE)
+
+    fun shortBurst(@Suppress("UNUSED_PARAMETER") supportsTickPrimitive: Boolean): VibrationEffect =
+        shortPulse
+
+    fun shortBurstFrom(
+        @Suppress("UNUSED_PARAMETER")
+        vibratorHelper: com.android.systemui.statusbar.VibratorHelper,
+    ): VibrationEffect = shortPulse
+
+    fun singleClick(): VibrationEffect = shortPulse
+}
