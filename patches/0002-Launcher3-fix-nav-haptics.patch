+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.quickstep.util
+
+import android.os.VibrationEffect
+import android.os.Vibrator
+
+/** Short continuous pulse (~42 ms), medium strength. */
+object FuxiHapticEffects {
+
+    private const val PULSE_MS = 42L
+    private const val PULSE_AMPLITUDE = 168
+
+    private val shortPulse: VibrationEffect =
+        VibrationEffect.createOneShot(PULSE_MS, PULSE_AMPLITUDE)
+
+    fun shortBurst(@Suppress("UNUSED_PARAMETER") vibrator: Vibrator): VibrationEffect = shortPulse
+
+    fun searchCommitEffect(vibrator: Vibrator): VibrationEffect = shortPulse
+}
