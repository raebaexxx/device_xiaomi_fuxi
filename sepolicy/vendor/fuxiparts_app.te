# Manual and automatic panel brightness.
allow fuxiparts_app_domain vendor_sysfs_graphics:dir search;
allow fuxiparts_app_domain vendor_sysfs_graphics:lnk_file r_file_perms;
allow fuxiparts_app_domain vendor_sysfs_graphics:file rw_file_perms;

# HBM feature 1 in the display-feature parameter block.
allow fuxiparts_app_domain vendor_sysfs_displayfeature:dir r_dir_perms;
allow fuxiparts_app_domain vendor_sysfs_displayfeature:lnk_file r_file_perms;
allow fuxiparts_app_domain vendor_sysfs_displayfeature:file rw_file_perms;
